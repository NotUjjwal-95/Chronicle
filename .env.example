# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Configurable Gemini model for AI-enriched reconstruction (default: gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"

# AI_PROVIDER: Default AI provider ("gemini" | "openai")
AI_PROVIDER="gemini"

# OPENAI_API_KEY: Optional API key if using OpenAI adapter
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# CHRONICLE_PERSISTENCE_MODE: "seed" for deterministic demonstration/testing or "supabase" for production PostgreSQL
CHRONICLE_PERSISTENCE_MODE="seed"

# SUPABASE_URL & KEYS: Required when CHRONICLE_PERSISTENCE_MODE="supabase"
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# GITHUB_TOKEN: Optional GitHub token for live PR artifact import
GITHUB_TOKEN=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
