# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Configurable Gemini model for AI-enriched reconstruction (default: gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"

# AI_PROVIDER: Default AI provider ("gemini" | "openai")
AI_PROVIDER="gemini"

# OPENAI_API_KEY: Optional API key if using OpenAI adapter
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# CHRONICLE_PERSISTENCE_MODE: "seed" for deterministic demonstration/testing or "supabase" for production PostgreSQL
CHRONICLE_PERSISTENCE_MODE="seed"

# SUPABASE_URL & KEYS: Required for Supabase Auth and PostgreSQL persistence
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# AUTHENTICATION & CANONICAL ORIGIN CONFIGURATION
# APP_URL: Sole authoritative server-side canonical application origin for security decisions
# (auth callback redirects, request origin validation, Host header verification).
# Must be an absolute HTTP or HTTPS URL with no credentials, path, query, or fragment.
# Format: "http://localhost:3000" (local) or "https://chronicle.example.com" (production).
APP_URL="http://localhost:3000"

# NEXT_PUBLIC_SITE_URL: Optional client-side public site URL (not used for server security decisions).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
CHRONICLE_REQUIRE_EMAIL_CONFIRMATION="false"
CHRONICLE_TEST_AUTH_ENABLED="false"

# GITHUB_TOKEN: Optional GitHub token for live PR artifact import
GITHUB_TOKEN=""
